; $MODE = "UniformRegister"
; $SAMPLER_VARS[0].name = "attribs"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $SAMPLER_VARS[1].name = "edges"
; $SAMPLER_VARS[1].type = "sampler2D"
; $SAMPLER_VARS[1].location = 1
; $UNIFORM_VARS[0].name = "depthMargin"
; $UNIFORM_VARS[0].type = "float4"
; $UNIFORM_VARS[0].count = 1
; $UNIFORM_VARS[0].offset = 0
; $UNIFORM_VARS[0].block = -1
; $NUM_SPI_PS_INPUT_CNTL = 3
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[2].SEMANTIC = 2
; $SPI_PS_INPUT_CNTL[2].DEFAULT_VAL = 1
; $DB_SHADER_CONTROL.KILL_ENABLE = true

; Edge marking: R0 has this pixel's coordinates, and R1 and R2 have those of the neighbors left and right, then down
; and up. The attributes texture has the ID times 4 plus flags (1 = solid), and the depth. A solid pixel is marked if
; a neighbor has a different ID and a depth greater than its own times C0.x plus C0.y, and gets the edge color for its
; ID, whose alpha is how much it's blended in. Each instruction group has a single instruction, since groups can't read
; the same channel of different registers at once, which the assembler doesn't check.
00 TEX: ADDR(80) CNT(5) VALID_PIX
    0  SAMPLE R3, R0.xy00, t0, s0
    1  SAMPLE R4, R1.xy00, t0, s0
    2  SAMPLE R5, R1.zw00, t0, s0
    3  SAMPLE R6, R2.xy00, t0, s0
    4  SAMPLE R7, R2.zw00, t0, s0
01 ALU: ADDR(32) CNT(40)
    5  x: MUL R8.x, R3.x, (0x3E800000, 0.25f).x
    6  y: MUL R8.y, R4.x, (0x3E800000, 0.25f).x
    7  z: MUL R8.z, R5.x, (0x3E800000, 0.25f).x
    8  w: MUL R8.w, R6.x, (0x3E800000, 0.25f).x
    9  x: MUL R9.x, R7.x, (0x3E800000, 0.25f).x
   10  x: FLOOR R8.x, R8.x
   11  y: FLOOR R8.y, R8.y
   12  z: FLOOR R8.z, R8.z
   13  w: FLOOR R8.w, R8.w
   14  x: FLOOR R9.x, R9.x
   15  x: SETNE R10.x, R8.y, R8.x
   16  y: SETNE R10.y, R8.z, R8.x
   17  z: SETNE R10.z, R8.w, R8.x
   18  w: SETNE R10.w, R9.x, R8.x
   19  y: MULADD R9.y, R3.y, C0.x, C0.y
   20  x: SETGT R11.x, R4.y, R9.y
   21  y: SETGT R11.y, R5.y, R9.y
   22  z: SETGT R11.z, R6.y, R9.y
   23  w: SETGT R11.w, R7.y, R9.y
   24  x: MUL R10.x, R10.x, R11.x
   25  y: MUL R10.y, R10.y, R11.y
   26  z: MUL R10.z, R10.z, R11.z
   27  w: MUL R10.w, R10.w, R11.w
   28  x: ADD R12.x, R10.x, R10.y
   29  y: ADD R12.y, R10.z, R10.w
   30  x: ADD R12.x, R12.x, R12.y
   31  z: MUL R9.z, R3.x, (0x3F000000, 0.5f).x
   32  z: FRACT R9.z, R9.z
   33  w: SETGT R9.w, R9.z, (0x3E800000, 0.25f).x
   34  z: MUL R12.z, R12.x, R9.w
   35  x: MUL R13.x, R3.x, (0x3B800000, 0.00390625f).x
   36  y: MOV R13.y, (0x3F000000, 0.5f).x
   37  x: KILLE ____, R12.z, (0x00000000, 0.0f).x
02 TEX: ADDR(90) CNT(1) VALID_PIX
   38  SAMPLE R14, R13.xy00, t1, s1
03 EXP_DONE: PIX0, R14
END_OF_PROGRAM
