; $MODE = "UniformRegister"
; $SAMPLER_VARS[0].name = "attribs"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $SAMPLER_VARS[1].name = "colors"
; $SAMPLER_VARS[1].type = "sampler2D"
; $SAMPLER_VARS[1].location = 1
; $UNIFORM_VARS[0].name = "attribScale"
; $UNIFORM_VARS[0].type = "float4"
; $UNIFORM_VARS[0].count = 1
; $UNIFORM_VARS[0].offset = 0
; $UNIFORM_VARS[0].block = -1
; $NUM_SPI_PS_INPUT_CNTL = 3
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[2].SEMANTIC = 2
; $SPI_PS_INPUT_CNTL[2].DEFAULT_VAL = 1
; $SQ_PGM_EXPORTS_PS.EXPORT_MODE = 4
; $CB_SHADER_CONTROL.RT0_ENABLE = true
; $CB_SHADER_CONTROL.RT1_ENABLE = true
; $DB_SHADER_CONTROL.KILL_ENABLE = true

; Crack filling: R0 has this pixel's coordinates, and R1 and R2 have those of the neighbors right and left, then down
; and up. The attributes texture has the ID and flags, scaled back by C0.x, whose whole part is odd for solid pixels.
; A pixel is a crack if no solid polygon drew it, and solid polygons drew both neighbors across it; it's dropped
; otherwise. Cracks take the color and attributes of the neighbor up, or of the one left if they're not across it
; that way. Each instruction group has a single instruction, since groups can't read the same channel of different
; registers at once, which the assembler doesn't check.
00 TEX: ADDR(80) CNT(7) VALID_PIX
    0  SAMPLE R3, R0.xy00, t0, s0
    1  SAMPLE R4, R1.xy00, t0, s0
    2  SAMPLE R5, R1.zw00, t0, s0
    3  SAMPLE R6, R2.xy00, t0, s0
    4  SAMPLE R7, R2.zw00, t0, s0
    5  SAMPLE R8, R1.zw00, t1, s1
    6  SAMPLE R9, R2.zw00, t1, s1
01 ALU: ADDR(32) CNT(33)
    7  x: MUL R12.x, R3.x, C0.x
    8  x: FLOOR R12.x, R12.x
    9  x: MUL R12.x, R12.x, 0.5f
   10  x: FRACT R12.x, R12.x
   11  x: KILLGT ____, R12.x, (0x3E800000, 0.25f).x
   12  x: MUL R13.x, R4.x, C0.x
   13  x: FLOOR R13.x, R13.x
   14  x: MUL R13.x, R13.x, 0.5f
   15  x: FRACT R13.x, R13.x
   16  y: MUL R13.y, R5.x, C0.x
   17  y: FLOOR R13.y, R13.y
   18  y: MUL R13.y, R13.y, 0.5f
   19  y: FRACT R13.y, R13.y
   20  z: MUL R13.z, R6.x, C0.x
   21  z: FLOOR R13.z, R13.z
   22  z: MUL R13.z, R13.z, 0.5f
   23  z: FRACT R13.z, R13.z
   24  w: MUL R13.w, R7.x, C0.x
   25  w: FLOOR R13.w, R13.w
   26  w: MUL R13.w, R13.w, 0.5f
   27  w: FRACT R13.w, R13.w
   28  x: MUL R14.x, R13.x, R13.y
   29  y: MUL R14.y, R13.z, R13.w
   30  z: MAX R14.z, R14.x, R14.y
   31  x: KILLGT ____, (0x3E000000, 0.125f).x, R14.z
   32  x: CNDGT R15.x, R14.y, R7.x, R5.x
   33  y: CNDGT R15.y, R14.y, R7.y, R5.y
   34  x: CNDGT R16.x, R14.y, R9.x, R8.x
   35  y: CNDGT R16.y, R14.y, R9.y, R8.y
   36  z: CNDGT R16.z, R14.y, R9.z, R8.z
   37  w: CNDGT R16.w, R14.y, R9.w, R8.w
02 EXP: PIX0, R16
03 EXP_DONE: PIX1, R15
END_OF_PROGRAM
