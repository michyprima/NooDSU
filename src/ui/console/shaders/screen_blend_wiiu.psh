; $MODE = "UniformRegister"
; $SAMPLER_VARS[0].name = "screen"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $SAMPLER_VARS[1].name = "lastScreen"
; $SAMPLER_VARS[1].type = "sampler2D"
; $SAMPLER_VARS[1].location = 1
; $NUM_SPI_PS_INPUT_CNTL = 2
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1

; Screen with ghosting: R0 has the texture coordinates and R1 the vertex color. This frame's screen and the last
; frame's are averaged like the DS's slow screen would, then given the vertex color like the regular shader does.
; Each instruction group has a single instruction, since groups can't read the same channel of different registers at
; once, which the assembler doesn't check.
00 TEX: ADDR(48) CNT(2) VALID_PIX
    0  SAMPLE R2, R0.xy00, t0, s0
    1  SAMPLE R3, R0.xy00, t1, s1
01 ALU: ADDR(32) CNT(12)
    2  x: ADD R4.x, R2.x, R3.x
    3  y: ADD R4.y, R2.y, R3.y
    4  z: ADD R4.z, R2.z, R3.z
    5  w: ADD R4.w, R2.w, R3.w
    6  x: MUL R4.x, R4.x, 0.5f
    7  y: MUL R4.y, R4.y, 0.5f
    8  z: MUL R4.z, R4.z, 0.5f
    9  w: MUL R4.w, R4.w, 0.5f
   10  x: MUL R4.x, R4.x, R1.x
   11  y: MUL R4.y, R4.y, R1.y
   12  z: MUL R4.z, R4.z, R1.z
   13  w: MUL R4.w, R4.w, R1.w
02 EXP_DONE: PIX0, R4
END_OF_PROGRAM
