; $MODE = "UniformRegister"
; $SAMPLER_VARS[0].name = "texture"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $UNIFORM_VARS[0].name = "texelSize"
; $UNIFORM_VARS[0].type = "float4"
; $UNIFORM_VARS[0].count = 1
; $UNIFORM_VARS[0].offset = 0
; $UNIFORM_VARS[0].block = -1
; $UNIFORM_VARS[1].name = "attribEncode"
; $UNIFORM_VARS[1].type = "float4"
; $UNIFORM_VARS[1].count = 2
; $UNIFORM_VARS[1].offset = 8
; $UNIFORM_VARS[1].block = -1
; $NUM_SPI_PS_INPUT_CNTL = 3
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[2].SEMANTIC = 2
; $SPI_PS_INPUT_CNTL[2].DEFAULT_VAL = 1
; $SQ_PGM_EXPORTS_PS.EXPORT_MODE = 4
; $CB_SHADER_CONTROL.RT0_ENABLE = true
; $CB_SHADER_CONTROL.RT1_ENABLE = true

; Texture coordinates are in texels: they're rounded down and sampled at texel centers, since the GPU rounds
; coordinates near texel edges to the nearest, which picks the next texel where the DS wouldn't. A tiny bias keeps
; coordinates that are whole numbers from falling just short. C0 has the size of a texel.
; R0.zw and R2.y have the distances to the polygon's outer edges from the pixel center; the nearest one gives how much
; of the pixel the polygon covers, for anti-aliasing. How much isn't covered goes in the fraction of the ID and flags
; attribute, which is whole otherwise, scaled to stay below 1.
; The attributes are then encoded by C2 and C3, which leave them as they are for full-precision attributes, or fit
; them in 16 bits each: the ID and flags times C2.x plus C2.y, and the depth times C2.z, or with C3.x set, its log
; times C2.w.
00 ALU: ADDR(32) CNT(15)
    0  x: MIN R5.x, R0.z, R0.w
    1  x: MIN R5.x, R5.x, R2.y
    2  x: ADD R5.x, R5.x, 0.5f
    3  x: MAX R5.x, R5.x, 0.0f
    4  x: MIN R5.x, R5.x, 1.0f
    5  x: ADD R5.x, -R5.x, 1.0f
    6  x: ADD R0.x, R0.x, (0x3B000000, 0.001953125f).x
       y: ADD R0.y, R0.y, (0x3B000000, 0.001953125f).x
    7  x: FLOOR R0.x, R0.x
       y: FLOOR R0.y, R0.y
    8  x: ADD R0.x, R0.x, 0.5f
       y: ADD R0.y, R0.y, 0.5f
    9  x: MUL R0.x, R0.x, C0.x
       y: MUL R0.y, R0.y, C0.y
01 TEX: ADDR(80) CNT(1) VALID_PIX
   10  SAMPLE R0, R0.xy00, t0, s0
02 ALU: ADDR(47) CNT(20)
   11  x: ADD R6.x, R0.x, -R1.x
       y: ADD R6.y, R0.y, -R1.y
       z: ADD R6.z, R0.z, -R1.z
   12  x: MUL R6.x, R6.x, R0.w
       y: MUL R6.y, R6.y, R0.w
       z: MUL R6.z, R6.z, R0.w
   13  x: ADD R1.x, R1.x, R6.x
       y: ADD R1.y, R1.y, R6.y
       z: ADD R1.z, R1.z, R6.z
   14  t: RECIP_IEEE R4.x, R2.z
   15  y: MUL R2.y, R2.w, R4.x
   16  x: ADD R2.x, R2.x, 0.5f
   17  x: FLOOR R2.x, R2.x
   18  x: MULADD R2.x, R5.x, (0x3F7C0000, 0.984375f).x, R2.x
   19  x: MULADD R2.x, R2.x, C2.x, C2.y
   20  t: LOG_IEEE R4.y, R2.y
   21  y: MUL R4.y, R4.y, C2.w
   22  z: MUL R4.z, R2.y, C2.z
   23  y: CNDE R2.y, C3.x, R4.z, R4.y
03 EXP: PIX0, R1
04 EXP_DONE: PIX1, R2
END_OF_PROGRAM
