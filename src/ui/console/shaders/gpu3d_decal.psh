; $MODE = "UniformRegister"
; $SAMPLER_VARS[0].name = "texture"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $NUM_SPI_PS_INPUT_CNTL = 2
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1

00 TEX: ADDR(48) CNT(1) VALID_PIX
    0  SAMPLE R0, R0, t0, s0
01 ALU: ADDR(32) CNT(9)
    1  x: ADD R2.x, R0.x, -R1.x
       y: ADD R2.y, R0.y, -R1.y
       z: ADD R2.z, R0.z, -R1.z
    2  x: MUL R2.x, R2.x, R0.w
       y: MUL R2.y, R2.y, R0.w
       z: MUL R2.z, R2.z, R0.w
    3  x: ADD R1.x, R1.x, R2.x
       y: ADD R1.y, R1.y, R2.y
       z: ADD R1.z, R1.z, R2.z
02 EXP_DONE: PIX0, R1
END_OF_PROGRAM
